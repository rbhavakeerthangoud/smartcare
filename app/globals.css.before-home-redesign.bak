@import "tailwindcss";

/* ============================================================
   SmartCare Design Tokens
   ============================================================ */

:root {
  color-scheme: light;

  /* Surfaces */
  --sc-background:    #f5f7f3;
  --sc-surface:       #ffffff;
  --sc-surface-soft:  #eef3ed;
  --sc-surface-raised:#f9fbf8;

  /* Brand */
  --sc-primary:       #1f6b4f;
  --sc-primary-dark:  #164c39;
  --sc-primary-soft:  #dcebe3;
  --sc-accent:        #a8d5ba;
  --sc-link:          #1f6b4f;

  /* Typography */
  --sc-text:          #17211c;
  --sc-muted:         #647069;

  /* Borders & shadows */
  --sc-border:        #e1e7e2;
  --sc-shadow:        0 12px 32px rgb(25 52 38 / 5%);

  /* Semantic */
  --sc-success:       #2f7d5b;
  --sc-warning:       #a87422;
  --sc-danger:        #a94745;

  /* Tailwind compat aliases */
  --background:       var(--sc-background);
  --foreground:       var(--sc-text);
}

[data-theme="dark"] {
  color-scheme: dark;

  --sc-background:    #0d1210;
  --sc-surface:       #141c18;
  --sc-surface-soft:  #19231e;
  --sc-surface-raised:#202b25;

  --sc-primary:       #35664f;
  --sc-primary-dark:  #294f3d;
  --sc-primary-soft:  #233d30;
  --sc-accent:        #91c5a7;
  --sc-link:          #9bceaf;

  --sc-text:          #f1f4f1;
  --sc-muted:         #a5b0a9;
  --sc-border:        #2b3931;
  --sc-shadow:        0 12px 32px rgb(0 0 0 / 18%);

  --sc-success:       #78b99a;
  --sc-warning:       #d5ad66;
  --sc-danger:        #e08c86;
}

/* ============================================================
   Tailwind v4 theme bridge
   ============================================================ */

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans:        var(--font-geist-sans);
  --font-mono:        var(--font-geist-mono);
}

/* ============================================================
   Base resets & globals
   ============================================================ */

* {
  box-sizing: border-box;
}

body {
  min-height: 100%;
  background:
    radial-gradient(ellipse at 4% 0%,   rgb(168 213 186 / 13%), transparent 36rem),
    radial-gradient(ellipse at 100% 28%, rgb(220 235 227 / 16%), transparent 32rem),
    var(--sc-background);
  color: var(--sc-text);
  font-family: var(--font-geist-sans), "Inter", sans-serif;
  transition: background-color 180ms ease, color 180ms ease;
}

[data-theme="dark"] body {
  background:
    radial-gradient(ellipse at 0%   0%,  rgb(31 107 79 / 14%),  transparent 34rem),
    radial-gradient(ellipse at 100% 25%, rgb(25 35  30 / 28%),  transparent 34rem),
    var(--sc-background);
}

::selection {
  background: var(--sc-primary-soft);
  color: var(--sc-text);
}

:focus-visible {
  outline: 2px solid var(--sc-primary);
  outline-offset: 2px;
}

/* Shared interactive-element transitions */
button,
a,
input,
select,
textarea {
  transition:
    color            150ms ease,
    background-color 150ms ease,
    border-color     150ms ease,
    box-shadow       150ms ease,
    opacity          150ms ease,
    transform        150ms ease;
}

button:not(:disabled):active {
  transform: scale(0.985);
}

/* Default form field borders */
input,
select,
textarea {
  border-color: var(--sc-border);
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--sc-primary);
}

/* Page-level enter animation */
main {
  animation: sc-page-enter 240ms ease-out both;
}

[role="progressbar"] > div {
  transition: width 650ms cubic-bezier(0.2, 0.75, 0.25, 1);
}

/* ============================================================
   Keyframes
   ============================================================ */

@keyframes sc-page-enter {
  from { opacity: 0; transform: translateY(5px); }
  to   { opacity: 1; transform: translateY(0);   }
}

@keyframes sc-pop-in {
  from { opacity: 0; transform: translateY(-4px) scale(0.985); }
  to   { opacity: 1; transform: translateY(0)    scale(1);     }
}

@keyframes sc-shimmer {
  from { background-position:  200% 0; }
  to   { background-position: -200% 0; }
}

@keyframes sc-fade-up {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0);   }
}

@keyframes sc-fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* ============================================================
   Animation utilities
   ============================================================ */

.sc-animate-fade-up           { animation: sc-fade-up 300ms ease-out both; }
.sc-animate-fade-up-delay-1   { animation: sc-fade-up 300ms ease-out  60ms both; }
.sc-animate-fade-up-delay-2   { animation: sc-fade-up 300ms ease-out 120ms both; }
.sc-animate-fade-up-delay-3   { animation: sc-fade-up 300ms ease-out 180ms both; }
.sc-animate-fade-in           { animation: sc-fade-in 250ms ease-out both; }

/* ============================================================
   Brand & layout primitives
   ============================================================ */

/* Logo / brand mark icon */
.sc-brand-mark {
  display: inline-grid;
  width: 2.35rem;
  height: 2.35rem;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 0.8rem;
  background: var(--sc-primary);
  color: #fff;
}

/* Generic surface panel */
.sc-panel {
  border: 1px solid var(--sc-border);
  background: var(--sc-surface);
  box-shadow: var(--sc-shadow);
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.sc-panel:hover {
  box-shadow: 0 16px 38px rgb(25 52 38 / 8%);
}

/* Muted text helper */
.sc-muted {
  color: var(--sc-muted);
}

/* Horizontal rule */
.sc-divider {
  border: none;
  border-top: 1px solid var(--sc-border);
}

/* Notification / dropdown pop-in */
.sc-notification-panel {
  animation: sc-pop-in 160ms ease-out both;
  transform-origin: top right;
}

/* ============================================================
   Hero sections  (intentionally use !important for color
   overrides because these containers always have dark/coloured
   backgrounds regardless of the surrounding theme)
   ============================================================ */

/* Login page — dark emerald gradient, white text is intentional */
.sc-login-hero {
  color: #fff !important;
}

.sc-login-hero .text-white\/80,
.sc-login-hero .text-white\/60 {
  color: rgb(255 255 255 / 80%) !important;
}

/* Admin header banner — branded gradient */
.sc-admin-hero {
  background: linear-gradient(145deg, var(--sc-primary-dark), var(--sc-primary));
  color: #fff !important;
}

.sc-admin-hero .text-slate-300 {
  color: rgb(255 255 255 / 78%) !important;
}

.sc-admin-hero .text-white {
  color: #fff !important;
}

/* ============================================================
   Genuinely dark card surface  (use sparingly)
   ============================================================ */

.sc-dark-surface {
  background: #111915;
  border: 1px solid #263028;
  border-radius: 1rem;
  color: #e8ede9;
}

.sc-dark-surface .sc-muted-text {
  color: #8ba090;
}

/* ============================================================
   Typography scale
   ============================================================ */

.sc-page-title {
  font-size: 2rem;
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--sc-text);
  line-height: 1.2;
}

.sc-section-label {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--sc-primary);
}

/* ============================================================
   Card variants
   ============================================================ */

.sc-card {
  border: 1px solid var(--sc-border);
  background: var(--sc-surface);
  border-radius: 1rem;
  padding: 1.25rem;
  box-shadow: var(--sc-shadow);
}

.sc-card-lg {
  border: 1px solid var(--sc-border);
  background: var(--sc-surface);
  border-radius: 1.25rem;
  padding: 1.5rem;
  box-shadow: var(--sc-shadow);
}

/* ============================================================
   Form controls
   ============================================================ */

.sc-form-label {
  display: block;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--sc-text);
  margin-bottom: 0.375rem;
}

.sc-form-hint {
  font-size: 0.75rem;
  color: var(--sc-muted);
  margin-top: 0.375rem;
}

.sc-input {
  width: 100%;
  min-height: 2.75rem;
  border-radius: 0.625rem;
  border: 1px solid var(--sc-border);
  background: var(--sc-surface);
  color: var(--sc-text);
  padding: 0.625rem 0.875rem;
  font-size: 0.875rem;
  transition: border-color 150ms ease, box-shadow 150ms ease;
}

.sc-input:focus {
  outline: none;
  border-color: var(--sc-primary);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--sc-primary) 14%, transparent);
}

.sc-select {
  width: 100%;
  min-height: 2.75rem;
  border-radius: 0.625rem;
  border: 1px solid var(--sc-border);
  background: var(--sc-surface);
  color: var(--sc-text);
  padding: 0.625rem 0.875rem;
  font-size: 0.875rem;
}

/* ============================================================
   Button variants
   ============================================================ */

.sc-btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.75rem;
  border-radius: 0.625rem;
  background: var(--sc-primary);
  color: #fff;
  font-size: 0.875rem;
  font-weight: 600;
  padding: 0 1.25rem;
  transition: background-color 150ms ease, transform 120ms ease, box-shadow 150ms ease;
  box-shadow: 0 1px 3px rgb(0 0 0 / 10%);
}

.sc-btn-primary:hover:not(:disabled)  { background: var(--sc-primary-dark); }
.sc-btn-primary:disabled              { opacity: 0.55; cursor: not-allowed; }

.sc-btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.75rem;
  border-radius: 0.625rem;
  border: 1px solid var(--sc-border);
  background: var(--sc-surface);
  color: var(--sc-text);
  font-size: 0.875rem;
  font-weight: 500;
  padding: 0 1rem;
  transition: background-color 150ms ease;
}

.sc-btn-secondary:hover:not(:disabled) { background: var(--sc-surface-soft); }

.sc-btn-danger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.75rem;
  border-radius: 0.625rem;
  border: 1px solid color-mix(in srgb, var(--sc-danger) 30%, var(--sc-border));
  background: color-mix(in srgb, var(--sc-danger) 8%, var(--sc-surface));
  color: var(--sc-danger);
  font-size: 0.875rem;
  font-weight: 500;
  padding: 0 1rem;
  transition: background-color 150ms ease;
}

.sc-btn-danger:hover:not(:disabled) {
  background: color-mix(in srgb, var(--sc-danger) 14%, var(--sc-surface));
}

/* ============================================================
   Badge variants
   ============================================================ */

.sc-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  border-radius: 9999px;
  padding: 0.25rem 0.75rem;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.sc-badge-primary { background: var(--sc-primary-soft);                                            color: var(--sc-primary); }
.sc-badge-success { background: color-mix(in srgb, var(--sc-success) 12%, var(--sc-surface));      color: var(--sc-success); }
.sc-badge-warning { background: color-mix(in srgb, var(--sc-warning) 12%, var(--sc-surface));      color: var(--sc-warning); }
.sc-badge-danger  { background: color-mix(in srgb, var(--sc-danger)  12%, var(--sc-surface));      color: var(--sc-danger);  }
.sc-badge-neutral { background: var(--sc-surface-soft);                                            color: var(--sc-muted);   }

/* ============================================================
   Table
   ============================================================ */

.sc-table {
  width: 100%;
  font-size: 0.875rem;
  border-collapse: collapse;
}

.sc-table thead {
  border-bottom: 1px solid var(--sc-border);
}

.sc-table th {
  padding: 0.75rem 1rem;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--sc-muted);
  text-align: left;
}

.sc-table td {
  padding: 0.875rem 1rem;
  border-bottom: 1px solid var(--sc-border);
  color: var(--sc-text);
}

.sc-table tbody tr:last-child td { border-bottom: none; }
.sc-table tbody tr:hover   td    { background: var(--sc-surface-soft); }

/* ============================================================
   Metric cards
   ============================================================ */

.sc-metric {
  border: 1px solid var(--sc-border);
  background: var(--sc-surface);
  border-radius: 1rem;
  padding: 1.25rem 1.5rem;
  box-shadow: var(--sc-shadow);
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.sc-metric:hover {
  transform: translateY(-1px);
  box-shadow: 0 16px 38px rgb(25 52 38 / 8%);
}

.sc-metric-label  { font-size: 0.8125rem; font-weight: 500; color: var(--sc-muted);                              }
.sc-metric-value  { font-size: 2rem;      font-weight: 600; color: var(--sc-text);  line-height: 1.1; margin-top: 0.25rem; }
.sc-metric-detail { font-size: 0.75rem;                     color: var(--sc-muted);                   margin-top: 0.375rem; }

/* ============================================================
   Skeleton / shimmer loader
   ============================================================ */

.sc-skeleton {
  border-radius: 0.5rem;
  background: linear-gradient(
    90deg,
    var(--sc-surface-soft)   25%,
    var(--sc-surface-raised) 50%,
    var(--sc-surface-soft)   75%
  );
  background-size: 200% 100%;
  animation: sc-shimmer 1.6s ease-in-out infinite;
}

/* ============================================================
   Alert banners
   ============================================================ */

.sc-alert-error {
  border: 1px solid color-mix(in srgb, var(--sc-danger)  30%, var(--sc-border));
  background: color-mix(in srgb, var(--sc-danger)  8%, var(--sc-surface));
  color: var(--sc-danger);
  border-radius: 0.75rem;
  padding: 0.875rem 1rem;
  font-size: 0.875rem;
}

.sc-alert-success {
  border: 1px solid color-mix(in srgb, var(--sc-success) 30%, var(--sc-border));
  background: color-mix(in srgb, var(--sc-success) 8%, var(--sc-surface));
  color: var(--sc-success);
  border-radius: 0.75rem;
  padding: 0.875rem 1rem;
  font-size: 0.875rem;
}

.sc-alert-warning {
  border: 1px solid color-mix(in srgb, var(--sc-warning) 30%, var(--sc-border));
  background: color-mix(in srgb, var(--sc-warning) 8%, var(--sc-surface));
  color: var(--sc-warning);
  border-radius: 0.75rem;
  padding: 0.875rem 1rem;
  font-size: 0.875rem;
}

/* ============================================================
   Miscellaneous helpers
   ============================================================ */

/* Inline status indicator dot */
.sc-status-dot {
  display: inline-block;
  width: 0.5rem;
  height: 0.5rem;
  border-radius: 9999px;
  flex-shrink: 0;
}

/* ============================================================
   Reduced-motion overrides  (!important intentional here)
   ============================================================ */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior:          auto   !important;
    animation-duration:       0.01ms !important;
    animation-iteration-count: 1     !important;
    transition-duration:      0.01ms !important;
  }
}
